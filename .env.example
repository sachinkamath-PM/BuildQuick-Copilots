# Local development defaults require no external services.
APP_ENV=development
APP_SECRET=replace-with-a-long-random-value
AUTH_MODE=local
DATABASE_URL=sqlite:///work/copilots.db
ASSISTANT_PROVIDER=mock
REQUEST_LIMIT_PER_MINUTE=180
FEATURE_TYCHE=true
FEATURE_PLUTUS=true
FEATURE_NOUS=true
MIGRATE_ON_STARTUP=true
GUEST_RETENTION_HOURS=24
GUEST_CLEANUP_INTERVAL_SECONDS=3600
ALLOWED_HOSTS=localhost,127.0.0.1

# Public demo profile (use unique secrets and non-sensitive data only).
# APP_ENV=demo
# AUTH_MODE=guest
# ALLOWED_HOSTS=copilots.buildquick.co.in,localhost,127.0.0.1
# POSTGRES_PASSWORD=replace-with-a-url-safe-random-password

# Production identity-provider token introspection.
# AUTH_MODE=introspection
# IDENTITY_INTROSPECTION_URL=https://identity.example.com/oauth2/introspect
# IDENTITY_CLIENT_ID=
# IDENTITY_CLIENT_SECRET=

# PostgreSQL and OpenAI Responses API.
# DATABASE_URL=postgresql://user:password@host:5432/copilots
# ASSISTANT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-terra
# OPENAI_REASONING_EFFORT=low
